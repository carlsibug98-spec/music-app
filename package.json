{
  "name": "resona",
  "private": true,
  "version": "0.1.0",
  "description": "Resona — private music streaming app. Native iOS + Android clients, zero-cost Node.js backend.",
  "type": "module",
  "workspaces": [
    "server",
    "packages/api-types",
    "packages/design-tokens"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w server",
    "test": "npm run test -w server",
    "lint": "npm run lint -w server",
    "build": "npm run build -w server",
    "tokens": "npm run generate -w @resona/design-tokens",
    "test:tracks": "node server/scripts/make-test-tracks.mjs"
  }
}
