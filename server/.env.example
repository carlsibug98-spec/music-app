# Resona API — environment
# Copy to .env and adjust. .env is gitignored.

# Postgres (docker compose up gives you this locally)
DATABASE_URL="postgresql://resona:resona@localhost:5432/resona"

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Catalog adapter (M1 interface; the extraction sidecar is out of scope)
CATALOG_YTM_ENABLED=false
# YTM_RESOLVER_URL=http://127.0.0.1:8787
# CATALOG_YTM_TTL_MS=86400000
