{
  "$schema": "./tokens.schema.md",
  "name": "Midnight Leaf",
  "version": "1.0.0",
  "notes": [
    "All values extracted from design/reference-mockup.html (docs/03-DESIGN-SYSTEM.md).",
    "dim raised from #7F7F7F to #8F8F8F for WCAG AA contrast on bg (doc 03 §7).",
    "Edit this file, then run: npm run tokens  (regenerates Kotlin + Swift constants)."
  ],
  "color": {
    "bg": "#121212",
    "black": "#000000",
    "card": "#1F1F1F",
    "card2": "#282828",
    "chip": "#2A2A2A",
    "line": "#2F2F2F",
    "text": "#FFFFFF",
    "sub": "#B3B3B3",
    "dim": "#8F8F8F",
    "green": "#1ED760",
    "red": "#F15E6C",
    "mini": "#4A1F16",
    "blue": "#3B8DFF"
  },
  "gradient": {
    "warm": ["#C7743F", "#4A2312"],
    "warm2": ["#8A4A2A", "#2A140B"],
    "warm3": ["#B56A3C", "#3B1D0E"],
    "dark": ["#4D5A66", "#171B20"],
    "blue": ["#3AA7FF", "#132A5C"],
    "gold": ["#F5C96B", "#7A4B12"],
    "green": ["#2FBF8F", "#0C4D3A"],
    "teal": ["#22C1CF", "#0B4F57"],
    "violet": ["#9B72FF", "#2B1657"],
    "sunset": ["#FF8A4C", "#7A1F3D"],
    "grey": ["#A3A9B6", "#3A3E49"],
    "liked": ["#6F5CFF", "#C6B8FF"],
    "spades": ["#B06A2C", "#3A1D0C", "#121212"]
  },
  "type": {
    "family": "Figtree",
    "fallback": {
      "ios": "SF Pro",
      "android": "Roboto"
    },
    "styles": {
      "hero": { "sizeMin": 34, "sizeMax": 40, "weight": 900, "trackingEm": -0.02 },
      "h1": { "sizeMin": 26, "sizeMax": 26, "weight": 800, "trackingEm": -0.02 },
      "h2": { "sizeMin": 20, "sizeMax": 22, "weight": 700, "trackingEm": -0.01 },
      "big": { "sizeMin": 22, "sizeMax": 22, "weight": 700, "trackingEm": 0 },
      "lyric": { "sizeMin": 24, "sizeMax": 24, "weight": 800, "trackingEm": -0.01 },
      "body": { "sizeMin": 16, "sizeMax": 16, "weight": 500, "trackingEm": 0 },
      "sub": { "sizeMin": 14, "sizeMax": 14, "weight": 400, "trackingEm": 0 },
      "chip": { "sizeMin": 13, "sizeMax": 14, "weight": 600, "trackingEm": 0 },
      "label": { "sizeMin": 12, "sizeMax": 12, "weight": 400, "trackingEm": 0 },
      "nav": { "sizeMin": 11, "sizeMax": 11, "weight": 600, "trackingEm": 0 }
    }
  },
  "space": {
    "base": 4,
    "screenX": 14,
    "xs": 6,
    "sm": 8,
    "md": 12,
    "lg": 14,
    "xl": 18,
    "section": 24,
    "rowMin": 64,
    "rowCompact": 56,
    "sheetRow": 50,
    "settingsRow": 48,
    "quickTile": 56,
    "genreTile": 78,
    "cardSize": 150,
    "artRow": 48,
    "navBar": 64,
    "miniPlayer": 56,
    "miniFloat": 8
  },
  "radius": {
    "art": 6,
    "card": 10,
    "sheetTop": 12,
    "pill": 16,
    "cta": 22,
    "field": 6
  },
  "motion": {
    "enter": { "ms": 240, "curve": [0.23, 1.0, 0.32, 1.0], "rise": 8 },
    "press": { "ms": 160, "scale": 0.97 },
    "sheet": { "ms": 320, "curve": [0.32, 0.72, 0.0, 1.0], "scrimMs": 250, "maxHeightPct": 84 },
    "nowPlaying": { "ms": 380, "curve": [0.32, 0.72, 0.0, 1.0] },
    "drawer": { "ms": 320, "curve": [0.2, 0.8, 0.2, 1.0], "widthPct": 88 },
    "dialog": { "ms": 250, "scaleFrom": 0.96 },
    "toast": { "ms": 300, "dismissMs": 1800, "bottom": 132 },
    "toggle": { "ms": 200 },
    "lyric": { "ms": 200 },
    "dragShadow": "0 10px 24px rgba(0,0,0,0.5)"
  }
}
